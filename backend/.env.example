# Copy this file to backend/.env and fill in real values. Never commit .env.

# Port the Express server listens on (defaults to 5000 if unset)
PORT=5000

# Gmail account used by nodemailer to send contact-form submissions.
# The address is both the sender account and the recipient of the emails.
GMAIL_USER=your-email@gmail.com

# Use a Gmail App Password (requires 2-Step Verification on the account),
# not the account's normal login password.
GMAIL_PASS=your-gmail-app-password
